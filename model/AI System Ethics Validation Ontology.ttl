@prefix : <http://example.com#>.
@prefix gufo: <http://purl.org/nemo/gufo#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<http://example.com> rdf:type owl:Ontology;
    owl:imports gufo:.
:IAGenerativa rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "IA Generativa"@en.
:SoftwareGeradoPorIA rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Software Gerado por IA"@en.
:CriterioEtico rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Critério Ético"@en.
:Framework rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Framework"@en.
:EmConformidade rdf:type owl:Class, gufo:Phase, owl:NamedIndividual;
    rdfs:label "Em conformidade"@en.
:EmViolacao rdf:type owl:Class, gufo:Phase, owl:NamedIndividual;
    rdfs:label "Em violação"@en.
:AvaliacaoDeConformidade rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:Relator;
    rdfs:label "Avaliação de Conformidade"@en.
:NivelDeRisco rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:Quality;
    rdfs:label "Nível de Risco"@en.
:Dominio rdf:type owl:Class, gufo:RoleMixin, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Domínio"@en.
:AgenteAvaliador rdf:type owl:Class, gufo:Category, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Agente Avaliador"@en.
:Legislacao rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Legislação"@en.
:InstrumentoNormativo rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Instrumento Normativo"@en.
:DesenvolvedorDeSoftware rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Desenvolvedor de Software"@en.
:EngenheiroDeSoftware rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Engenheiro de Software"@en.
:OrgaoRegulador rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Orgão Regulador"@en.
:AtoNormativo rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:Relator;
    rdfs:label "Ato Normativo"@en.
:Profissional rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:label "Profissional"@en.
:Organizacao rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:label "Organização"@en.
:AnalistaDeQualidade rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Analista de Qualidade"@en.
:TimeDeGovernanca rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Time de Governança"@en.
:GeracaoDeSoftware rdf:type owl:Class, gufo:EventType, owl:NamedIndividual;
    rdfs:subClassOf gufo:Event;
    rdfs:label "Geração de Software"@en.
:Critico rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Crítico"@en.
:Alto rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Alto"@en.
:Medio rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Médio"@en.
:Baixo rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Baixo"@en.
:Transparencia rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Transparência"@en.
:Equidade rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Equidade"@en.
:Privacidade rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Privacidade"@en.
:Responsabilidade rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Responsabilidade"@en.
:ResultadoDaConformidade rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:IntrinsicMode;
    rdfs:label "Resultado da Conformidade"@en.
:Atendido rdf:type owl:Class, gufo:Phase, owl:NamedIndividual;
    rdfs:label "Atendido"@en.
:Violado rdf:type owl:Class, gufo:Phase, owl:NamedIndividual;
    rdfs:label "Violado"@en.
:Setorial rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Setorial"@en.
:Geral rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Geral"@en.
:Saude rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Saúde"@en.
:Financeiro rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Financeiro"@en.
:Juridico rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Jurídico"@en.
:Educacao rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Educação"@en.
:DesenvolvimentoDeSoftware rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Desenvolvimento de Software"@en.
:AutomacaoDeTarefas rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Automação de Tarefas"@en.
:Audiovisual rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Audiovisual"@en.
:GeracaoDeConteudo rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Geração de Conteúdo"@en.
:ComiteDeEtica rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Comitê de Ética"@en.
:Framework rdfs:subClassOf :InstrumentoNormativo.
:EmViolacao rdfs:subClassOf :SoftwareGeradoPorIA.
:EmConformidade rdfs:subClassOf :SoftwareGeradoPorIA.
:Legislacao rdfs:subClassOf :InstrumentoNormativo.
:DesenvolvedorDeSoftware rdfs:subClassOf :Profissional.
:EngenheiroDeSoftware rdfs:subClassOf :Profissional.
:AnalistaDeQualidade rdfs:subClassOf :Profissional.
:OrgaoRegulador rdfs:subClassOf :Organizacao.
:TimeDeGovernanca rdfs:subClassOf :Organizacao.
:Profissional rdfs:subClassOf :AgenteAvaliador.
:Organizacao rdfs:subClassOf :AgenteAvaliador.
:Critico rdfs:subClassOf :NivelDeRisco.
:Alto rdfs:subClassOf :NivelDeRisco.
:Medio rdfs:subClassOf :NivelDeRisco.
:Baixo rdfs:subClassOf :NivelDeRisco.
:Transparencia rdfs:subClassOf :CriterioEtico.
:Equidade rdfs:subClassOf :CriterioEtico.
:Privacidade rdfs:subClassOf :CriterioEtico.
:Responsabilidade rdfs:subClassOf :CriterioEtico.
:Atendido rdfs:subClassOf :ResultadoDaConformidade.
:Violado rdfs:subClassOf :ResultadoDaConformidade.
:Saude rdfs:subClassOf :Setorial.
:Financeiro rdfs:subClassOf :Setorial.
:Juridico rdfs:subClassOf :Setorial.
:Educacao rdfs:subClassOf :Setorial.
:Saude rdfs:subClassOf :Dominio.
:Financeiro rdfs:subClassOf :Dominio.
:Juridico rdfs:subClassOf :Dominio.
:Educacao rdfs:subClassOf :Dominio.
:DesenvolvimentoDeSoftware rdfs:subClassOf :Geral.
:AutomacaoDeTarefas rdfs:subClassOf :Geral.
:Audiovisual rdfs:subClassOf :Geral.
:GeracaoDeConteudo rdfs:subClassOf :Geral.
:DesenvolvimentoDeSoftware rdfs:subClassOf :Dominio.
:AutomacaoDeTarefas rdfs:subClassOf :Dominio.
:Audiovisual rdfs:subClassOf :Dominio.
:GeracaoDeConteudo rdfs:subClassOf :Dominio.
:ComiteDeEtica rdfs:subClassOf :Organizacao.
:SoftwareGeradoPorIA owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:EmViolacao :EmConformidade)
].
[ rdf:type owl:AllDisjointClasses ] owl:members (:Legislacao :Framework).
:InstrumentoNormativo owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:Legislacao :Framework)
].
[ rdf:type owl:AllDisjointClasses ] owl:members (:Profissional :Organizacao).
:AgenteAvaliador owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:Profissional :Organizacao)
].
:NivelDeRisco owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:Alto :Critico :Medio :Baixo)
].
[ rdf:type owl:AllDisjointClasses ] owl:members (:Equidade :Responsabilidade :Transparencia :Privacidade).
:CriterioEtico owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:Equidade :Responsabilidade :Transparencia :Privacidade)
].
:ResultadoDaConformidade owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:Violado :Atendido)
].
:Dominio owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:Saude :Audiovisual :Juridico :AutomacaoDeTarefas :DesenvolvimentoDeSoftware :Financeiro :Educacao :GeracaoDeConteudo)
].
:Estabelece rdf:type owl:ObjectProperty;
    rdfs:domain :CriterioEtico;
    rdfs:range :InstrumentoNormativo;
    rdfs:label "Estabelece"@en;
    rdf:type gufo:MaterialRelationshipType.
:agenteAvaliadorHasCriterioEtico rdf:type owl:ObjectProperty;
    rdfs:domain :AgenteAvaliador;
    rdfs:range :CriterioEtico;
    rdf:type gufo:MaterialRelationshipType.
:Utiliza_1 rdf:type owl:ObjectProperty;
    rdfs:domain :AgenteAvaliador;
    rdfs:range :SoftwareGeradoPorIA;
    rdfs:label "Utiliza"@en;
    rdf:type gufo:MaterialRelationshipType.
:criterioEticoHasSoftwareGeradoPorIa rdf:type owl:ObjectProperty;
    rdfs:domain :CriterioEtico;
    rdfs:range :SoftwareGeradoPorIA;
    rdf:type gufo:MaterialRelationshipType.
:Valida rdf:type owl:ObjectProperty;
    rdfs:domain :ResultadoDaConformidade;
    rdfs:range :SoftwareGeradoPorIA;
    rdfs:label "Valida"@en;
    rdf:type gufo:MaterialRelationshipType.
:avaliacaoDeConformidadeHasDesenvolvedorDeSoftware rdf:type owl:ObjectProperty;
    rdfs:domain :AvaliacaoDeConformidade;
    rdfs:range :DesenvolvedorDeSoftware;
    rdf:type gufo:MaterialRelationshipType.
:avaliacaoDeConformidadeHasEngenheiroDeSoftware rdf:type owl:ObjectProperty;
    rdfs:domain :AvaliacaoDeConformidade;
    rdfs:range :EngenheiroDeSoftware;
    rdf:type gufo:MaterialRelationshipType.
:avaliacaoDeConformidadeHasAnalistaDeQualidade rdf:type owl:ObjectProperty;
    rdfs:domain :AvaliacaoDeConformidade;
    rdfs:range :AnalistaDeQualidade;
    rdf:type gufo:MaterialRelationshipType.
:avaliacaoDeConformidadeHasOrgaoRegulador rdf:type owl:ObjectProperty;
    rdfs:domain :AvaliacaoDeConformidade;
    rdfs:range :OrgaoRegulador;
    rdf:type gufo:MaterialRelationshipType.
:avaliacaoDeConformidadeHasTimeDeGovernanca rdf:type owl:ObjectProperty;
    rdfs:domain :AvaliacaoDeConformidade;
    rdfs:range :TimeDeGovernanca;
    rdf:type gufo:MaterialRelationshipType.
:AvaliacaoDeConformidade rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty gufo:mediates;
  owl:someValuesFrom :SoftwareGeradoPorIA
].
:NivelDeRisco rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty [ owl:inverseOf gufo:inheresIn ];
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :IAGenerativa
].
:IAGenerativa rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty gufo:inheresIn;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :NivelDeRisco
].
:AgenteAvaliador rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty gufo:mediates;
  owl:someValuesFrom :AvaliacaoDeConformidade
].
:AtoNormativo rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty gufo:mediates;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :CriterioEtico
], [
  rdf:type owl:Restriction;
  owl:onProperty gufo:mediates;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :InstrumentoNormativo
].
:GeracaoDeSoftware rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty [ owl:inverseOf gufo:participatedIn ];
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :IAGenerativa
].
:IAGenerativa rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty gufo:participatedIn;
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :GeracaoDeSoftware
].
:GeracaoDeSoftware rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty [ owl:inverseOf gufo:wasCreatedIn ];
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :SoftwareGeradoPorIA
].
:SoftwareGeradoPorIA rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty gufo:wasCreatedIn;
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :GeracaoDeSoftware
].
:AvaliacaoDeConformidade rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty gufo:mediates;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :IAGenerativa
], [
  rdf:type owl:Restriction;
  owl:onProperty gufo:mediates;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :ResultadoDaConformidade
].
:AnalistaDeQualidade rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty [ owl:inverseOf :avaliacaoDeConformidadeHasAnalistaDeQualidade ];
  owl:someValuesFrom :AvaliacaoDeConformidade
].
:AvaliacaoDeConformidade rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty :avaliacaoDeConformidadeHasAnalistaDeQualidade;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :AnalistaDeQualidade
].
