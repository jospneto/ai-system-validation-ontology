@prefix : <http://example.com#>.
@prefix gufo: <http://purl.org/nemo/gufo#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<http://example.com> rdf:type owl:Ontology;
    owl:imports gufo:.
:GenerativeAI rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Generative AI"@en.
:AIGeneratedSoftware rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "AI-Generated Software"@en.
:Framework rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Framework"@en.
:Compliant rdf:type owl:Class, gufo:Phase, owl:NamedIndividual;
    rdfs:label "Compliant"@en.
:NonCompliant rdf:type owl:Class, gufo:Phase, owl:NamedIndividual;
    rdfs:label "Non-Compliant"@en.
:ComplianceAssessment rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:Relator;
    rdfs:label "Compliance Assessment"@en.
:RiskLevel rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:IntrinsicMode;
    rdfs:label "\tRisk Level"@en.
:Domain rdf:type owl:Class, gufo:RoleMixin, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Domain"@en.
:Appraiser rdf:type owl:Class, gufo:Category, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Appraiser"@en.
:Legislation rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Legislation"@en.
:NormativeInstrument rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "\tNormative Instrument"@en.
:SoftwareDeveloper rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Software Developer"@en.
:SoftwareEngineer rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Software Engineer"@en.
:RegulatoryBody rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Regulatory Body"@en.
:NormativeAct rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:Relator;
    rdfs:label "Normative Act"@en.
:Professional rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:label "Professional"@en.
:Organization rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:label "Organization"@en.
:QualityAnalyst rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Quality Analyst"@en.
:GovernanceTeam rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Governance Team"@en.
:SoftwareGeneration rdf:type owl:Class, gufo:EventType, owl:NamedIndividual;
    rdfs:subClassOf gufo:Event;
    rdfs:label "Software Generation"@en.
:Critical rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "\tCritical"@en.
:High rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "High"@en.
:Medium rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "\tMedium"@en.
:Low rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Low"@en.
:Transparency rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Transparency"@en.
:Fairness rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Fairness"@en.
:Privacy rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "\tPrivacy"@en.
:Accountability rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "\tAccountability"@en.
:ComplianceResult rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:IntrinsicMode;
    rdfs:label "Compliance Result"@en.
:Fulfilled rdf:type owl:Class, gufo:Phase, owl:NamedIndividual;
    rdfs:label "Fulfilled"@en.
:Violated rdf:type owl:Class, gufo:Phase, owl:NamedIndividual;
    rdfs:label "Violated"@en.
:Industry rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Industry"@en.
:General rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "General"@en.
:Healthcare rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "\tHealthcare"@en.
:Financial rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "\tFinancial"@en.
:Legal rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Legal"@en.
:Education rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Education"@en.
:SoftwareDevelopment rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Software Development"@en.
:TaskAutomation rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Task Automation"@en.
:Audiovisual rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "\tAudiovisual"@en.
:ContentGeneration rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Content Generation"@en.
:EthicsCommittee rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Ethics Committee"@en.
:AppliedSoftware rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Applied Software\n"@en.
:ApplicableCriterion rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Applicable Criterion"@en.
:CriterionApplicability rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:Relator;
    rdfs:label "Criterion Applicability"@en.
:DomainApplication rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:Relator;
    rdfs:label "Domain Application"@en.
:IssuingInstrument rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Issuing Instrument\n"@en.
:EstablishedCriterion rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Established Criterion\n"@en.
:EthicalCriterion rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Ethical Criterion"@en.
:Framework rdfs:subClassOf :NormativeInstrument.
:NonCompliant rdfs:subClassOf :AIGeneratedSoftware.
:Compliant rdfs:subClassOf :AIGeneratedSoftware.
:Legislation rdfs:subClassOf :NormativeInstrument.
:SoftwareDeveloper rdfs:subClassOf :Professional.
:SoftwareEngineer rdfs:subClassOf :Professional.
:QualityAnalyst rdfs:subClassOf :Professional.
:RegulatoryBody rdfs:subClassOf :Organization.
:GovernanceTeam rdfs:subClassOf :Organization.
:Professional rdfs:subClassOf :Appraiser.
:Organization rdfs:subClassOf :Appraiser.
:Critical rdfs:subClassOf :RiskLevel.
:High rdfs:subClassOf :RiskLevel.
:Medium rdfs:subClassOf :RiskLevel.
:Low rdfs:subClassOf :RiskLevel.
:Fulfilled rdfs:subClassOf :ComplianceResult.
:Violated rdfs:subClassOf :ComplianceResult.
:Healthcare rdfs:subClassOf :Industry.
:Financial rdfs:subClassOf :Industry.
:Legal rdfs:subClassOf :Industry.
:Education rdfs:subClassOf :Industry.
:Healthcare rdfs:subClassOf :Domain.
:Financial rdfs:subClassOf :Domain.
:Legal rdfs:subClassOf :Domain.
:Education rdfs:subClassOf :Domain.
:SoftwareDevelopment rdfs:subClassOf :General.
:TaskAutomation rdfs:subClassOf :General.
:Audiovisual rdfs:subClassOf :General.
:ContentGeneration rdfs:subClassOf :General.
:SoftwareDevelopment rdfs:subClassOf :Domain.
:TaskAutomation rdfs:subClassOf :Domain.
:Audiovisual rdfs:subClassOf :Domain.
:ContentGeneration rdfs:subClassOf :Domain.
:EthicsCommittee rdfs:subClassOf :Organization.
:AppliedSoftware rdfs:subClassOf :AIGeneratedSoftware.
:IssuingInstrument rdfs:subClassOf :NormativeInstrument.
:Transparency rdfs:subClassOf :EthicalCriterion.
:Fairness rdfs:subClassOf :EthicalCriterion.
:Privacy rdfs:subClassOf :EthicalCriterion.
:Accountability rdfs:subClassOf :EthicalCriterion.
:ApplicableCriterion rdfs:subClassOf :EthicalCriterion.
:EstablishedCriterion rdfs:subClassOf :EthicalCriterion.
:AIGeneratedSoftware owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:Compliant :NonCompliant)
].
[ rdf:type owl:AllDisjointClasses ] owl:members (:Legislation :Framework).
:NormativeInstrument owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:Legislation :Framework)
].
[ rdf:type owl:AllDisjointClasses ] owl:members (:Organization :Professional).
:Appraiser owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:Organization :Professional)
].
:RiskLevel owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:Critical :High :Low :Medium)
].
:ComplianceResult owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:Fulfilled :Violated)
].
:Domain owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:TaskAutomation :Audiovisual :Healthcare :Education :ContentGeneration :SoftwareDevelopment :Financial :Legal)
].
:General owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:TaskAutomation :SoftwareDevelopment :Audiovisual :ContentGeneration)
].
[ rdf:type owl:AllDisjointClasses ] owl:members (:Transparency :Fairness :Accountability :Privacy).
:EthicalCriterion owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:Transparency :Fairness :Accountability :Privacy)
].
:uses_1 rdf:type owl:ObjectProperty;
    rdfs:domain :Appraiser;
    rdfs:range :AIGeneratedSoftware;
    rdfs:label "uses"@en;
    rdf:type gufo:MaterialRelationshipType.
:toValidate rdf:type owl:ObjectProperty;
    rdfs:domain :ComplianceResult;
    rdfs:range :AIGeneratedSoftware;
    rdfs:label "to validate"@en;
    rdf:type gufo:MaterialRelationshipType.
:complianceAssessmentHasSoftwareDeveloper rdf:type owl:ObjectProperty;
    rdfs:domain :ComplianceAssessment;
    rdfs:range :SoftwareDeveloper;
    rdf:type gufo:MaterialRelationshipType.
:complianceAssessmentHasSoftwareEngineer rdf:type owl:ObjectProperty;
    rdfs:domain :ComplianceAssessment;
    rdfs:range :SoftwareEngineer;
    rdf:type gufo:MaterialRelationshipType.
:complianceAssessmentHasQualityAnalyst rdf:type owl:ObjectProperty;
    rdfs:domain :ComplianceAssessment;
    rdfs:range :QualityAnalyst;
    rdf:type gufo:MaterialRelationshipType.
:complianceAssessmentHasRegulatoryBody rdf:type owl:ObjectProperty;
    rdfs:domain :ComplianceAssessment;
    rdfs:range :RegulatoryBody;
    rdf:type gufo:MaterialRelationshipType.
:complianceAssessmentHasGovernanceTeam rdf:type owl:ObjectProperty;
    rdfs:domain :ComplianceAssessment;
    rdfs:range :GovernanceTeam;
    rdf:type gufo:MaterialRelationshipType.
:complianceAssessmentHasEthicsCommittee rdf:type owl:ObjectProperty;
    rdfs:domain :ComplianceAssessment;
    rdfs:range :EthicsCommittee;
    rdf:type gufo:MaterialRelationshipType.
:applicableIn rdf:type owl:ObjectProperty;
    rdfs:domain :Domain;
    rdfs:range :ApplicableCriterion;
    rdfs:label "applicable in\n"@en;
    rdf:type gufo:MaterialRelationshipType.
:appliedIn rdf:type owl:ObjectProperty;
    rdfs:domain :Domain;
    rdfs:range :AppliedSoftware;
    rdfs:label "applied in"@en;
    rdf:type gufo:MaterialRelationshipType.
:establishes rdf:type owl:ObjectProperty;
    rdfs:domain :EstablishedCriterion;
    rdfs:range :IssuingInstrument;
    rdfs:label "establishes"@en;
    rdf:type gufo:MaterialRelationshipType.
:establishes_1 rdf:type owl:ObjectProperty;
    rdfs:domain :EthicalCriterion;
    rdfs:range :NormativeInstrument;
    rdfs:label "establishes"@en;
    rdf:type gufo:MaterialRelationshipType.
:ethicalCriterionHasAiGeneratedSoftware rdf:type owl:ObjectProperty;
    rdfs:domain :EthicalCriterion;
    rdfs:range :AIGeneratedSoftware;
    rdf:type gufo:MaterialRelationshipType.
:appraiserHasEthicalCriterion rdf:type owl:ObjectProperty;
    rdfs:domain :Appraiser;
    rdfs:range :EthicalCriterion;
    rdf:type gufo:MaterialRelationshipType.
:ComplianceAssessment rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty gufo:mediates;
  owl:someValuesFrom :AIGeneratedSoftware
].
:RiskLevel rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty [ owl:inverseOf gufo:inheresIn ];
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :GenerativeAI
].
:GenerativeAI rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty gufo:inheresIn;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :RiskLevel
].
:Appraiser rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty gufo:mediates;
  owl:someValuesFrom :ComplianceAssessment
].
:NormativeAct rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty gufo:mediates;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :NormativeInstrument
].
:SoftwareGeneration rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty [ owl:inverseOf gufo:participatedIn ];
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :GenerativeAI
].
:GenerativeAI rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty gufo:participatedIn;
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :SoftwareGeneration
].
:SoftwareGeneration rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty [ owl:inverseOf gufo:wasCreatedIn ];
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :AIGeneratedSoftware
].
:AIGeneratedSoftware rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty gufo:wasCreatedIn;
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :SoftwareGeneration
].
:ComplianceAssessment rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty gufo:mediates;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :GenerativeAI
], [
  rdf:type owl:Restriction;
  owl:onProperty gufo:mediates;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :ComplianceResult
].
:QualityAnalyst rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty [ owl:inverseOf :complianceAssessmentHasQualityAnalyst ];
  owl:someValuesFrom :ComplianceAssessment
].
:ComplianceAssessment rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty :complianceAssessmentHasQualityAnalyst;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :QualityAnalyst
].
:Domain rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty [ owl:inverseOf gufo:mediates ];
  owl:someValuesFrom :CriterionApplicability
].
:CriterionApplicability rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty gufo:mediates;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :Domain
], [
  rdf:type owl:Restriction;
  owl:onProperty gufo:mediates;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :ApplicableCriterion
].
:Domain rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty [ owl:inverseOf gufo:mediates ];
  owl:someValuesFrom :DomainApplication
].
:DomainApplication rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty gufo:mediates;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :Domain
], [
  rdf:type owl:Restriction;
  owl:onProperty gufo:mediates;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :AppliedSoftware
].
:EstablishedCriterion rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty [ owl:inverseOf gufo:mediates ];
  owl:someValuesFrom :NormativeAct
].
:NormativeAct rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty gufo:mediates;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :EstablishedCriterion
].
:IssuingInstrument rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty [ owl:inverseOf gufo:mediates ];
  owl:someValuesFrom :NormativeAct
].
:NormativeAct rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty gufo:mediates;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :IssuingInstrument
], [
  rdf:type owl:Restriction;
  owl:onProperty gufo:mediates;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :EthicalCriterion
].
